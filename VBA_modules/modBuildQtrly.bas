Attribute VB_Name = "modBuildQtrly"
Option Explicit
'==============================================================================
' BuildQtrlySum - creates the QTRLY SUM schedule straight from LEASE_CALC
' (not from DETAIL cells, so a DETAIL rebuild can never break it).
'==============================================================================
Public Sub BuildQtrlySum()
    Dim ws As Worksheet
    Dim accts() As Double, sect() As Long, n As Long
    Dim r As Long, sec As Long, oi As Long, i As Long, c As Long, cnt As Long
    Dim firstR As Long, lastR As Long, endSched As Long

    Set ws = ThisWorkbook.Worksheets("QTRLY SUM")
    ResetSheet ws
    n = CollectAccounts(accts, sect)

    ws.Columns("A").ColumnWidth = 11
    ws.Columns("B").ColumnWidth = 46
    ws.Columns("C").ColumnWidth = 4
    For c = 4 To 7
        ws.Columns(c).ColumnWidth = 13
    Next c
    ws.Columns("H").ColumnWidth = 14
    ws.Columns("I").ColumnWidth = 10

    ws.Range("A1").Formula = "=BuildingName&"" - QUARTERLY SUMMARY"""
    ws.Range("A1").Font.Bold = True
    ws.Range("A1").Font.Size = 14
    ws.Range("A2").Formula = "=""BUDGET FOR THE YEAR ""&BudgetYear"
    ws.Range("A2").Font.Bold = True
    ws.Range("A3").Value = "Status"
    ws.Range("A4").Value = "Last built"
    ws.Range("B4").Value = Now
    ws.Range("B4").NumberFormat = "yyyy-mm-dd hh:mm"
    ws.Range("B4").HorizontalAlignment = -4131
    ws.Range("A5").Value = "ACCT"
    ws.Range("B5").Value = "ACCOUNT NAME"
    ws.Range("D5").Value = "1ST QTR"
    ws.Range("E5").Value = "2ND QTR"
    ws.Range("F5").Value = "3RD QTR"
    ws.Range("G5").Value = "4TH QTR"
    ws.Range("H5").Value = "TOTAL"
    ws.Range("I5").Value = "$/SF"
    ws.Range("A5:I5").Font.Bold = True
    ws.Range("D5:I5").HorizontalAlignment = -4152
    BorderBottom ws, 5, 1, 9

    r = 7
    For oi = 1 To 14
        sec = SecOrder(oi)
        cnt = 0
        For i = 1 To n
            If sect(i) = sec Then cnt = cnt + 1
        Next i
        If cnt > 0 Then
            ws.Cells(r, 1).Value = SectionTitle(sec)
            ws.Cells(r, 1).Font.Bold = True
            r = r + 1
            firstR = r
            For i = 1 To n
                If sect(i) = sec Then
                    QtrAccountRow ws, r, accts(i), sec
                    r = r + 1
                End If
            Next i
            lastR = r - 1
            ws.Cells(r, 2).Value = SectionTotalTitle(sec)
            For c = 4 To 7
                ws.Cells(r, c).Formula = "=SUM(" & ColL(c) & firstR & ":" & ColL(c) & lastR & ")"
                ws.Cells(r, c).NumberFormat = NUMFMT
            Next c
            QtrTotalsCols ws, r
            ws.Range(ws.Cells(r, 1), ws.Cells(r, 9)).Font.Bold = True
            BorderTop ws, r, 1, 9
            r = r + 2
        End If
    Next oi
    If n = 0 Then
        ws.Cells(r, 1).Value = "No amounts found on LEASE_CALC yet."
        r = r + 2
    End If
    endSched = r - 2
    If endSched < 6 Then endSched = 6

    ' status (fixed cell B3): schedule rows must still match LEASE_CALC
    ws.Range("B3").Formula = "=IF(ABS(" & AcctTotalTerm() & "-SUMIFS($H$6:$H$" & endSched & ",$A$6:$A$" & endSched & ","">=1000000""))>=0.5,""REBUILD NEEDED - click Build Schedules"",""OK - schedules current"")"
    ws.Range("B3").Font.Bold = True
    ws.Range("B3").HorizontalAlignment = -4131
    ws.Cells(r, 1).Value = "This sheet is generated by the BuildQtrlySum macro - do not type on it."
    ws.Cells(r, 1).Font.Italic = True
    ws.Cells(r, 1).Font.Size = 9
    LockSheet ws
End Sub

Private Sub QtrAccountRow(ByVal ws As Worksheet, ByVal r As Long, ByVal acct As Double, ByVal sec As Long)
    Dim q As Long, m As Long, f As String, rc As String
    ws.Cells(r, 1).Value = acct
    ws.Cells(r, 1).NumberFormat = "0"
    ws.Cells(r, 1).HorizontalAlignment = -4131
    ws.Cells(r, 2).Formula = "=IFERROR(INDEX(COA_NAME,MATCH($A" & r & ",COA_ACCTNO,0)),""(not in chart of accounts)"")"
    For q = 1 To 4
        f = "="
        For m = 1 To 3
            rc = ColL(6 + (q - 1) * 3 + m)      ' LEASE_CALC months start in column G (7)
            If m > 1 Then f = f & "+"
            f = f & AcctMonthTerm(sec, rc, "$A" & r)
        Next m
        ws.Cells(r, 3 + q).Formula = f
        ws.Cells(r, 3 + q).NumberFormat = NUMFMT
    Next q
    QtrTotalsCols ws, r
End Sub

Private Sub QtrTotalsCols(ByVal ws As Worksheet, ByVal r As Long)
    ws.Cells(r, 8).Formula = "=SUM(D" & r & ":G" & r & ")"
    ws.Cells(r, 8).NumberFormat = NUMFMT
    ws.Cells(r, 9).Formula = "=IF(BillingSF=0,0,H" & r & "/BillingSF)"
    ws.Cells(r, 9).NumberFormat = NUMFMT2
End Sub
